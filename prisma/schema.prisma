generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  role          Role      @default(BILLER)
  isActive      Boolean   @default(true)
  mfaEnabled     Boolean   @default(true)
  mfaCode        String?
  mfaCodeExpiry  DateTime?
  mfaAttempts    Int       @default(0)
  mfaLockedUntil DateTime?
  mfaToken       String?
  mfaTokenExpiry DateTime?
  practice       Practice?
  practiceId     String?
  memberOf       Practice?  @relation("PracticeMembers", fields: [practiceId], references: [id])
  auditLogs      AuditLog[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Practice {
  id             String     @id @default(cuid())
  name           String
  npi            String?
  npiType2       String?    // Organization NPI (Box 49)
  taxId          String?    // EIN / Tax ID
  address        String?
  billingAddress String?    // If different from address
  state          String?
  userId         String     @unique
  user           User       @relation(fields: [userId], references: [id])
  members        User[]     @relation("PracticeMembers")
  claims         Claim[]
  providers      Provider[]
  monthEndCloses MonthEndClose[]
  createdAt      DateTime   @default(now())
}

model Claim {
  id                String        @id @default(cuid())
  practiceId        String
  practice          Practice      @relation(fields: [practiceId], references: [id])
  patientName       String
  patientDob        String    // encrypted ISO date string (AES-256-GCM)
  patientInsuranceId String
  payerId           String
  payerName         String
  planType          String?
  claimDate         DateTime
  serviceDate       DateTime
  cdtCodes          String[]
  toothNumbers      String[]
  diagnosisCodes    String    // encrypted JSON array (AES-256-GCM)
  totalAmount       Float
  providerNpi       String?
  preAuthNumber     String?
  xraysAttached     Boolean       @default(false)
  perioCharting     Boolean       @default(false)
  preAuthObtained   Boolean       @default(false)
  narrativeIncluded Boolean       @default(false)
  status            ClaimStatus   @default(PENDING)
  submittedAt       DateTime?
  denialRiskScore   Float?
  riskLevel         RiskLevel?
  aiAnalysis        Json?
  flaggedIssues     String[]
  suggestedCdtCodes String[]
  deniedAt          DateTime?
  denialReason      String?
  denialCode        String?
  appeal            Appeal?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Appeal {
  id              String        @id @default(cuid())
  claimId         String        @unique
  claim           Claim         @relation(fields: [claimId], references: [id])
  letterContent   String        @db.Text
  generatedAt     DateTime      @default(now())
  status          AppealStatus  @default(DRAFT)
  submittedAt     DateTime?
  resolution      String?
  resolvedAt      DateTime?
  amountRecovered Float?
  updatedAt       DateTime      @updatedAt
}

model Payer {
  id              String    @id @default(cuid())
  payerId         String    @unique
  name            String
  state           String?
  denialRate      Float?
  avgProcessDays  Int?
  commonDenialReasons String[]
  preferredCdtVariants Json?
  requiresPreAuth  String[]
  documentationQuirks String[]
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())
}

model AuditLog {
  id          String       @id @default(cuid())
  timestamp   DateTime     @default(now())
  userId      String?
  user        User?        @relation(fields: [userId], references: [id])
  userEmail   String
  action      AuditAction
  resource    String       // e.g. "claim:clm_abc123" — no PHI
  outcome     AuditOutcome
  ipAddress   String?
  details     String?      // non-PHI context only

  @@index([timestamp(sort: Desc)])
  @@index([userEmail])
  @@index([action])
}

enum Role {
  ADMIN
  OFFICE_MANAGER
  BILLER
  PROVIDER
}

enum AuditAction {
  LOGIN
  VIEW
  CREATE
  UPDATE
  DELETE
  UPDATE_USER_ROLE
  MONTH_END_CHECKLIST_ITEM
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

enum ClaimStatus {
  DRAFT
  PENDING
  SUBMITTED
  APPROVED
  DENIED
  APPEALING
  APPEAL_WON
  APPEAL_LOST
  CLOSED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AppealStatus {
  DRAFT
  SUBMITTED
  WON
  LOST
}

enum CredentialStatus {
  NOT_STARTED
  APPLICATION_SENT
  IN_PROCESS
  CREDENTIALED
  EXPIRED
  TERMINATED
  DENIED
}

model Provider {
  id            String               @id @default(cuid())
  practiceId    String
  practice      Practice             @relation(fields: [practiceId], references: [id])
  firstName     String
  lastName      String
  credentials   String
  npiType1      String
  licenseNumber String
  licenseState  String
  licenseExpiry DateTime
  deaNumber     String?
  specialty     String
  startDate     DateTime
  active        Boolean              @default(true)
  credentialing ProviderCredential[]
  events        CredentialingEvent[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model ProviderCredential {
  id              String           @id @default(cuid())
  providerId      String
  provider        Provider         @relation(fields: [providerId], references: [id])
  payerName       String
  payerId         String
  status          CredentialStatus @default(NOT_STARTED)
  applicationDate DateTime?
  approvalDate    DateTime?
  expiryDate      DateTime?
  contractType    String?
  providerNumber  String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model CredentialingEvent {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])
  payerName  String?
  event      String
  updatedBy  String
  notes      String?
  createdAt  DateTime @default(now())
}

model MonthEndClose {
  id          String         @id @default(cuid())
  practiceId  String
  practice    Practice       @relation(fields: [practiceId], references: [id])
  month       Int
  year        Int
  notes       String?
  closedAt    DateTime?
  items       MonthEndItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([practiceId, month, year])
}

model MonthEndItem {
  id        String        @id @default(cuid())
  closeId   String
  close     MonthEndClose @relation(fields: [closeId], references: [id])
  phase     Int
  itemKey   String
  checked   Boolean       @default(false)
  checkedBy String?
  checkedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([closeId, itemKey])
}
